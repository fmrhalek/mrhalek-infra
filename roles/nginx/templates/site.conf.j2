{% set all_names = [domain] + domain_aliases %}

server {
    listen 80;
    listen [::]:80;
    server_name {{ all_names | join(' ') }};

    # ACME HTTP-01 challenge always served over HTTP
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

{% if cert_exists %}
    # Redirect everything else to HTTPS once cert exists
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{ all_names | join(' ') }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Redirect www.* to apex over HTTPS
    if ($host != "{{ domain }}") {
        return 301 https://{{ domain }}$request_uri;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ motion_site_container_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
{% else %}
    # Cert not yet issued — proxy directly over HTTP (temporary, until certbot runs)
    location / {
        proxy_pass http://127.0.0.1:{{ motion_site_container_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
{% endif %}
